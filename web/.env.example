# Production must use an HTTPS endpoint. Do not include a trailing slash.
VITE_API_BASE_URL=https://api.example.com

# Optional local-only proxy target. Start Flask locally on this address, then use
# /backend-api as VITE_API_BASE_URL during Vite development.
VITE_DEV_API_TARGET=http://127.0.0.1:5000
