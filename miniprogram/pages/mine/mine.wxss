
.mine-head { padding-top: 12rpx; }
.guardian-card { margin-top: 28rpx; display: flex; justify-content: space-between; gap: 24rpx; }
.card-eyebrow { display: block; color: #07C160; font-size: 22rpx; font-weight: 900; margin-bottom: 18rpx; }
.avatar-row { display: flex; align-items: center; gap: 18rpx; }
.avatar-wrap { width: 92rpx; height: 92rpx; border-radius: 50%; background: #E8F8EE; color: #049A4F; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 900; overflow: hidden; }
.avatar-img { width: 100%; height: 100%; }
.guardian-name { display: block; color: #1D2129; font-size: 34rpx; font-weight: 900; }
.guardian-type { display: block; margin-top: 8rpx; color: #4E5969; font-size: 24rpx; }
.avoid-tags { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.health-index { flex-shrink: 0; min-width: 128rpx; text-align: right; }
.health-index text:first-child { display: block; color: #07C160; font-size: 54rpx; font-weight: 900; }
.health-index text:last-child { display: block; margin-top: 6rpx; color: #4E5969; font-size: 22rpx; }
.member-list { display: flex; gap: 22rpx; overflow-x: auto; }
.member-item { min-width: 96rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #4E5969; font-size: 22rpx; }
.member-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #F3F4F6; color: #4E5969; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 900; border: 3rpx solid transparent; overflow: hidden; }
.member-avatar image { width: 100%; height: 100%; }
.member-item.active .member-avatar { border-color: #07C160; background: #E8F8EE; color: #049A4F; }
.member-item.active { color: #1D2129; font-weight: 800; }
.body-group { padding: 22rpx 0; border-top: 1rpx solid #F3F4F6; }
.body-group:first-of-type { border-top: 0; }
.body-label { display: block; color: #4E5969; font-size: 22rpx; font-weight: 800; }
.body-value { display: block; margin-top: 10rpx; color: #1D2129; font-size: 30rpx; font-weight: 900; }
.body-group .fr-tag { margin-top: 14rpx; }
.ai-profile-card { border-left: 6rpx solid #7B61FF; }
.ai-title { color: #7B61FF; }
.profile-tags { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.profile-note { display: block; margin-top: 20rpx; color: #86909C; font-size: 22rpx; }
.settings-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.setting-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #F3F4F6; color: #1D2129; font-size: 28rpx; font-weight: 700; }
.setting-row:last-child { border-bottom: 0; }
.setting-row > text:last-child,
.setting-value { color: #86909C; font-size: 26rpx; font-weight: 600; }
.setting-value { display: flex; align-items: center; gap: 8rpx; }
.setting-row > text.setting-arrow,
.setting-value .setting-arrow { width: 32rpx; height: 32rpx; font-size: 24rpx; color: #C9CDD4; }
