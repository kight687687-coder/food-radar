.card-report-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 180rpx;
}

.develop-card {
  width: 100%;
  padding: 64rpx 36rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(229, 231, 235, 0.86);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.045);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.develop-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #F8FBFF 0%, #DDEBFF 100%);
  color: #1677FF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.12);
}

.develop-icon .iconfont {
  font-size: 58rpx;
}

.develop-title {
  margin-top: 28rpx;
  color: #1D2129;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.develop-desc {
  margin-top: 14rpx;
  max-width: 560rpx;
  color: #4E5969;
  font-size: 25rpx;
  line-height: 1.65;
  font-weight: 500;
}

.develop-actions {
  width: 100%;
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.develop-btn {
  width: 100%;
  max-width: 440rpx;
}

.develop-link {
  color: #07C160;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 850;
}
