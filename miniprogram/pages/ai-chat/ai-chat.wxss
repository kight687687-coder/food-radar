.ai-chat-page {
  padding-bottom: 150rpx;
}

.chat-head {
  padding-top: 8rpx;
}

.scope-card {
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F2EFFF 100%);
  border: 1rpx solid rgba(99, 102, 241, 0.16);
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.05);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.scope-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #7B61FF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scope-title {
  display: block;
  color: #1D2129;
  font-size: 30rpx;
  font-weight: 900;
}

.scope-desc {
  display: block;
  margin-top: 8rpx;
  color: #4E5969;
  font-size: 24rpx;
  line-height: 1.5;
}

.example-row {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.message-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-row.assistant {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.chat-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.assistant-avatar {
  background: #F2EFFF;
  box-shadow: 0 8rpx 18rpx rgba(123, 97, 255, 0.12);
}

.user-avatar {
  background: #E8F8EE;
  color: #049A4F;
}

.message {
  max-width: 72%;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message.assistant {
  background: #FFFFFF;
  color: #4E5969;
  border: 1rpx solid #E5E7EB;
  border-top-left-radius: 10rpx;
}

.message.user {
  background: #07C160;
  color: #FFFFFF;
  border-top-right-radius: 10rpx;
}

.message.loading {
  flex-direction: row;
  display: flex;
  gap: 8rpx;
  align-items: center;
  width: 116rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C9CDD4;
}

.chat-input-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 12rpx 10rpx 28rpx;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.1);
}

.chat-input {
  flex: 1;
  height: 68rpx;
  font-size: 26rpx;
  color: #1D2129;
}

.send-btn {
  width: 112rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: #07C160;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.send-btn.disabled {
  background: #C9CDD4;
}
