# Required for image text recognition
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# Required for AI chat and remote encyclopedia entries
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Comma-separated frontend origins. Example:
# ALLOWED_ORIGINS=https://your-site.vercel.app,https://www.example.com
ALLOWED_ORIGINS=

# Optional. Leave empty for the stateless Vercel deployment.
DATABASE_URL=
